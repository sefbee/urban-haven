# Install for the www-data user with: crontab -u www-data deploy/crontab
* * * * * cd /var/www/urban-haven && php artisan schedule:run >> /dev/null 2>&1
30 2 * * * /var/www/urban-haven/deploy/backup.sh /var/www/urban-haven >> /var/www/urban-haven/storage/logs/backup.log 2>&1
*/5 * * * * cd /var/www/urban-haven && php artisan uh:health > /dev/null 2>&1 || logger -t urban-haven "uh:health failed"
